# REUSE compliance: preserve exact file contents
# See: https://reuse.software/

LICENSES/** -text
LICENSE -text

# Line endings: normalize to LF on commit
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.go text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary
*.tar binary

# Git and IDE files
.gitignore text
.gitattributes text
